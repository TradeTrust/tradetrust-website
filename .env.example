# When running npm run build, the following environment variables are required to be set in the CI/CD environment variables
NODE_ENV=
NET=
# Suggest to use npm run build:(dev|test|prod) to build the website

# Clone this file to .env with the following values filled in / or set in CI/CD environment variables
## Required for mainnet
STABILITY_API_KEY=
## Required for testnet
STABILITY_TESTNET_API_KEY=
ASTRON_TESTNET_API_KEY=
## Required
INFURA_API_KEY=
MAGIC_API_KEY=
## Optional
ALCHEMY_API_KEY=
OKLINK_API_KEY=

## Required for Creator to work
DID_SERVER_URL=
DOCUMENT_STORAGE_URL=
API_KEY_DOCUMENT_STORAGE=

## Required for Testcafe
MAILSLURP_API_KEY=

## Optional for Sentry logging
SENTRY_DATA_SOURCE_NAME=

## Optional for DEFAULT_TEMPLATE_URL in Decentralised Renderer
DEFAULT_TEMPLATE_URL=

## Required for EIP-7702 gasless transactions
PIMLICO_API_KEY=

## Google sign-in web client. Public client id only; do not put the client secret here.
## Set the dev client in .env, .env.development and .env.test.
## Set the prod client in .env.production. The ID token stays in memory only.
GOOGLE_CLIENT_ID=

## trustvc-ai-functions origin. Local Docker API is http://localhost:8080.
## Production builds set this to the AWS API origin. No trailing slash.
TEMPLATE_GENERATOR_API_URL=
